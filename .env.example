# Amazon Photos Authentication Configuration
# Follow the instructions in QUICKSTART.md to obtain these 3 cookies from your browser.

# 1. session-id (e.g. 123-4567890-1234567)
AMAZON_SESSION_ID=your_session_id_here

# 2. User Browsing ID: ubid-main for US, or ubid-acbca, ubid-acbit, etc. for international
AMAZON_UBID_MAIN=your_ubid_main_here

# 3. Authentication Token: at-main for US, or at-acbca, at-acbit, etc. for international
AMAZON_AT_MAIN=your_at_main_here

# Optional: Top-Level Domain (default is 'com')
AMAZON_TLD=com
